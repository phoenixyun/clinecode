{
    "name": "@cline/packages",
    "private": true,
    "workspaces": [
        "sdk/packages/*",
        "apps/vscode",
        "apps/vscode/webview-ui",
        "apps/vscode/testing-platform"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "bun run clean && bun install && bun run build:sdk && bun -F clinecode compile",
        "build:sdk": "bun --production -F './sdk/packages/*' build",
        "build:models": "bun -F @cline/llms generate:models && bun format --write",
        "code": "bun --conditions=development -F clinecode dev",
        "clean": "bun run sdk/scripts/clean.ts",
        "types": "bun --parallel -F './sdk/packages/*' -F clinecode typecheck",
        "test": "bun --parallel -F './sdk/packages/**' test",
        "test:unit": "bash -lc 'set -euo pipefail; bun -F @cline/agents test & p1=$!; bun -F @cline/llms test & p2=$!; bun -F @cline/core test:unit & p3=$!; wait $p1; wait $p2; wait $p3'",
        "biome": "bunx --bun @biomejs/biome",
        "format": "bun biome format sdk/ apps/vscode/",
        "lint": "bun biome lint sdk/ apps/vscode/",
        "fix": "bun biome check --write --unsafe --diagnostic-level=error sdk/ apps/vscode/",
        "check": "bun biome check --diagnostic-level=error sdk/ apps/vscode/ && bun run build:sdk && bun run -F clinecode compile && bun --parallel -F './sdk/packages/*' -F clinecode typecheck && bun sdk/scripts/check-publish.ts",
        "version": "bun run types && bun sdk/scripts/version.ts",
        "release": "bun sdk/scripts/release.ts"
    },
    "lint-staged": {
        "sdk/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ],
        "apps/vscode/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "module": "index.ts",
    "type": "module",
    "engines": {
        "bun": "1.3.13",
        "node": ">=22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.5",
        "@types/bun": "^1.3.13",
        "@types/node": "^25.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "nanoid": "^5.1.7",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "tar-fs": ">=3.1.1",
        "tar": "^7.5.2",
        "js-yaml": "^4.1.1",
        "serialize-javascript": ">=7.0.3",
        "protobufjs": "7.5.8",
        "diff": "8.0.4",
        "@sap-cloud-sdk/connectivity": "4.6.0",
        "@sap-cloud-sdk/http-client": "4.6.0",
        "@sap-cloud-sdk/openapi": "4.6.0",
        "@sap-cloud-sdk/resilience": "4.6.0",
        "@sap-cloud-sdk/util": "4.6.0"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "grpc-tools"
    ],
    "packageManager": "bun@1.3.13"
}
